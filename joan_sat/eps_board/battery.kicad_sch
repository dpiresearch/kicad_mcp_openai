	(text "When 73.7% VNTC > NTC, the comparator will be open drain.\nThis indicates it is hot, and the heater should not be on.\nWhen NTC > 73.7% VNTC, the comparator will be high impedance and the load switch will turn on.\nNotice this resistor divider has (nearly) the same ratio as when the NTC is at it's cold point"
		(exclude_from_sim no)
		(at 46.99 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "f6f5951d-e8ba-4409-bcc2-9fe883f29e70")
	)
