	(lib_symbols)
	(text "AmSat LTM Host Interface"
		(exclude_from_sim no)
		(at 22.86 17.78 0)
		(effects
			(font
				(size 1.78 1.78)
			)
		)
		(uuid "f22c3d82-14c7-4a29-a670-f3ef2e3a1d60")
	)
	(text "J_LTM is a schematic placeholder for the LTM LIHU / PC-104 host connector. Replace it with exact LTM symbol, pinout, and footprint after LTM KiCad/Gerbers are available."
		(exclude_from_sim no)
		(at 22.86 24.13 0)
		(effects
			(font
				(size 1.02 1.02)
			)
		)
		(uuid "c7d6ba13-888b-47f8-be7c-b95748637446")
	)
	(text "Power / Safety
5.0 V +/-5%, ~2.9 W max. Keep LTM power gated until antennas are deployed and transmit is safe. Umbilical Attached: high on bench, low in flight."
		(exclude_from_sim no)
		(at 22.86 35.56 0)
		(effects
			(font
				(size 1.02 1.02)
			)
		)
		(uuid "217dae41-4004-40b4-bd51-c2d7f7e5b2ad")
	)
	(text "Data Interfaces
CAN is primary, extended 29-bit IDs. LTM optional I2C is master-only. LIHU UART loader must remain reachable through umbilical after integration."
		(exclude_from_sim no)
		(at 22.86 52.07 0)
		(effects
			(font
				(size 1.02 1.02)
			)
		)
		(uuid "856d35ad-4b74-4466-880f-dfaaf6a7e29d")
	)
	(text "RF / Telemetry
Host provides nominal 50 ohm VHF and UHF antenna paths. TLM1-4 are 0-3.3 V analog inputs; tie unused TLM inputs to GND."
		(exclude_from_sim no)
		(at 22.86 68.58 0)
		(effects
			(font
				(size 1.02 1.02)
			)
		)
		(uuid "14bc7c71-704e-4bfa-b400-07ecb66c9f9d")
	)
